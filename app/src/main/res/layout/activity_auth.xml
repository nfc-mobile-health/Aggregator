<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/med_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- Logo / Branding Block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="40dp">

            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/medical_card_bg"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient Portal"
                android:textSize="26sp"
                android:textColor="@color/med_green_primary"
                android:textStyle="bold"
                android:letterSpacing="0.02"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create or access your medical record"
                android:textSize="13sp"
                android:textColor="@color/med_text_secondary"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/medical_card_bg"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal Information"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/med_text_secondary"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/patientIdInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Patient ID (choose one — you log in with it)"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/medical_input_bg"
                android:inputType="text"
                android:textColor="@color/med_text_primary"
                android:textColorHint="@color/med_text_hint"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/patientName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Full Name"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/medical_input_bg"
                android:inputType="textPersonName"
                android:textColor="@color/med_text_primary"
                android:textColorHint="@color/med_text_hint"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/patientAge"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Age"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/medical_input_bg"
                android:inputType="number"
                android:textColor="@color/med_text_primary"
                android:textColorHint="@color/med_text_hint"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/patientGender"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Gender"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/medical_input_bg"
                android:inputType="text"
                android:textColor="@color/med_text_primary"
                android:textColorHint="@color/med_text_hint"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/patientBloodType"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Blood Type"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/medical_input_bg"
                android:inputType="text"
                android:textColor="@color/med_text_primary"
                android:textColorHint="@color/med_text_hint"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/patientSugar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Blood Sugar (mg/dL, optional)"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/medical_input_bg"
                android:inputType="number"
                android:textColor="@color/med_text_primary"
                android:textColorHint="@color/med_text_hint"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/patientHeight"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Height (cm, optional)"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/medical_input_bg"
                android:inputType="numberDecimal"
                android:textColor="@color/med_text_primary"
                android:textColorHint="@color/med_text_hint"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/patientWeight"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Weight (kg, optional)"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/medical_input_bg"
                android:inputType="numberDecimal"
                android:textColor="@color/med_text_primary"
                android:textColorHint="@color/med_text_hint"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/patientOxygenLevel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Oxygen Level (% SpO2, optional)"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/medical_input_bg"
                android:inputType="number"
                android:textColor="@color/med_text_primary"
                android:textColorHint="@color/med_text_hint"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <!-- PIN - encrypts the local database (set at registration) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp">

                <EditText
                    android:id="@+id/pinInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="PIN (secures your data)"
                    android:paddingStart="16dp"
                    android:paddingEnd="72dp"
                    android:background="@drawable/medical_input_bg"
                    android:inputType="numberPassword"
                    android:textColor="@color/med_text_primary"
                    android:textColorHint="@color/med_text_hint"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/pinVisibilityToggle"
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="Show"
                    android:textColor="@color/med_green_primary"
                    android:textSize="13sp"/>
            </FrameLayout>

        </LinearLayout>

        <!-- Actions -->
        <Button
            android:id="@+id/registerBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Register"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/med_green_primary"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/loginBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Access Existing Records"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:backgroundTint="@android:color/transparent"
            android:textColor="@color/med_green_primary"
            style="@style/Widget.AppCompat.Button.Borderless"/>

    </LinearLayout>
</ScrollView>
